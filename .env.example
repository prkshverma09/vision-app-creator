# ---------------------------------------------------------------------------
# Local development / demo (no paid keys needed)
# ---------------------------------------------------------------------------
VISION_APP_DATA_DIR=/tmp/vision-app-data
VISION_APP_TEST_TOKEN=token-local
VISION_APP_TEST_WORKSPACE=workspace-local
VISION_APP_TEST_USER=local-user
VISION_APP_ANALYSIS_MODE=scripted
GEMINI_MODEL=gemini-3.6-flash

# Synthetic annotation that makes the local detector produce a red-light event.
# Path is relative to the repo root.
VISION_APP_FIXTURE_ANNOTATION=fixtures/synthetic/annotations/red_light_violation.json

# ---------------------------------------------------------------------------
# Optional: live cloud / model / GPU acceptance (R01)
# ---------------------------------------------------------------------------
# These are only needed for real detection, real chat compilation, or cloud
# persistence. Keep them out of version control and never log them.

# Google Cloud project used by Firestore, GCS, and Gemini billing.
# GOOGLE_CLOUD_PROJECT=your-gcp-project

# GCS bucket for uploaded source videos and extracted evidence.
# GCS_BUCKET=your-bucket-name

# Path to a service-account JSON for Firestore / GCS access.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Gemini API key for chat-to-app compilation and optional video reasoning.
# GEMINI_API_KEY=your-gemini-api-key

# Modal credentials for GPU inference (RF-DETR).
# MODAL_TOKEN_ID=your-modal-token-id
# MODAL_TOKEN_SECRET=your-modal-token-secret

# Modal app/function names if you deployed the provided Modal package.
# R01_MODAL_APP=vision-app-creator
# R01_MODAL_RFDETR_FUNCTION=detect_frame

# Human/legal gate: set only after you have authorized footage and data rights.
# VISION_APP_R01_DATA_RIGHTS=confirmed

# Optional cost guardrail.
# VISION_APP_R01_MAX_MICROUSD=5000000
