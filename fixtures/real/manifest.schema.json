{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vision-app-creator.dataset-manifest.v1",
  "title": "Authorized dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "frozen_at": {"type": ["string", "null"], "format": "date-time"},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "common": {
      "type": "object",
      "required": ["id", "kind", "fixture_type", "split", "source_id", "camera_group", "provenance", "rights_record", "label_review"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["video", "prompt"]},
        "fixture_type": {"enum": ["real", "staged"]},
        "split": {"enum": ["development", "heldout"]},
        "source_id": {"type": "string", "minLength": 1},
        "camera_group": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1},
        "rights_record": {"type": "string", "minLength": 1},
        "label_review": {
          "type": "object",
          "required": ["reviewer", "reviewed_at"],
          "properties": {"reviewer": {"type": "string"}, "reviewed_at": {"type": "string", "format": "date-time"}}
        }
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms", "uncertainty_ms", "disposition"],
      "properties": {
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 0},
        "uncertainty_ms": {"type": "integer", "minimum": 0},
        "disposition": {"enum": ["positive", "negative", "unknown"]}
      }
    },
    "case": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {
          "if": {"properties": {"kind": {"const": "video"}}},
          "then": {
            "required": ["source_path", "source_sha256", "evidence", "truth_intervals"],
            "properties": {
              "source_path": {"type": "string"},
              "source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
              "truth_intervals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interval"}},
              "evidence": {
                "type": "object",
                "required": ["governing_signal_visible", "stop_line_visible", "approach_lane_visible"],
                "properties": {
                  "governing_signal_visible": {"const": true},
                  "stop_line_visible": {"const": true},
                  "approach_lane_visible": {"const": true}
                }
              }
            }
          },
          "else": {
            "required": ["prompt", "expected_outcome"],
            "properties": {
              "prompt": {"type": "string", "minLength": 1},
              "expected_outcome": {"enum": ["supported", "unsupported", "clarification"]}
            }
          }
        }
      ]
    }
  }
}
